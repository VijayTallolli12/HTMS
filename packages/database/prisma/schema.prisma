// Enterprise HMS — Multi-Schema Prisma Definition
// Architecture Baseline: W1-T02 Organization Model & W1-T03 Identity/IAM
// Domain Schemas: platform_schema (Organization & IAM), audit_schema (Outbox & Security Audit)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform_schema", "audit_schema", "pms_schema"]
}

// ==============================================================================
// 1. HOTEL GROUP (Corporate HQ Tier)
// ==============================================================================
model HotelGroup {
  id          String    @id
  code        String    @unique
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  regions        Region[]
  memberships    OrganizationMembership[]
  roles          Role[]
  userRoleScopes UserRoleScope[]

  @@index([status])
  @@index([deletedAt])
  @@map("hotel_groups")
  @@schema("platform_schema")
}

// ==============================================================================
// 2. REGION (Geographical / Cluster Tier)
// ==============================================================================
model Region {
  id           String     @id
  hotelGroupId String     @map("hotel_group_id")
  code         String
  name         String
  description  String?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  hotelGroup     HotelGroup      @relation(fields: [hotelGroupId], references: [id], onDelete: Restrict)
  countries      Country[]
  userRoleScopes UserRoleScope[]

  @@unique([hotelGroupId, code])
  @@index([hotelGroupId])
  @@index([status])
  @@index([deletedAt])
  @@map("regions")
  @@schema("platform_schema")
}

// ==============================================================================
// 3. COUNTRY (Jurisdictional Tier)
// ==============================================================================
model Country {
  id             String          @id
  regionId       String          @map("region_id")
  code           String          // ISO 3166-1 alpha-2 (e.g., 'JP', 'US', 'AE')
  name           String
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  region         Region          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  properties     Property[]
  userRoleScopes UserRoleScope[]

  @@unique([regionId, code])
  @@index([regionId])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("countries")
  @@schema("platform_schema")
}

// ==============================================================================
// 4. PROPERTY (Operational Hotel / Resort Unit Tier)
// ==============================================================================
model Property {
  id            String     @id
  countryId     String     @map("country_id")
  code          String     @unique // Globally unique enterprise property code
  name          String
  legalName     String?    @map("legal_name")
  status        String     @default("ACTIVE")
  timeZone      String     @map("time_zone") // IANA format (e.g., 'Asia/Tokyo')
  currency      String     @map("currency")  // ISO 4217 (e.g., 'JPY', 'USD')
  addressLine1  String?    @map("address_line1")
  addressLine2  String?    @map("address_line2")
  city          String?    @map("city")
  stateProvince String?    @map("state_province")
  postalCode    String?    @map("postal_code")
  phone         String?    @map("phone")
  email         String?    @map("email")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  country        Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  buildings      Building[]
  defaultUsers   User[]          @relation("UserDefaultProperty")
  userRoleScopes UserRoleScope[]
  roomTypes      RoomType[]
  rooms          Room[]
  ratePlans      RatePlan[]
  dailyInventory    DailyInventory[]
  guests            Guest[]
  reservations      Reservation[]
  maintenanceBlocks RoomMaintenanceBlock[]
  roomStatusLogs    RoomStatusLog[]

  @@index([countryId])
  @@index([status])
  @@index([deletedAt])
  @@map("properties")
  @@schema("platform_schema")
}

// ==============================================================================
// 5. BUILDING (Physical Tower / Wing Tier)
// ==============================================================================
model Building {
  id          String    @id
  propertyId  String    @map("property_id")
  code        String
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  floors      Floor[]
  rooms       Room[]

  @@unique([propertyId, code])
  @@unique([propertyId, id], name: "uq_buildings_property_id")
  @@index([propertyId])
  @@index([status])
  @@index([deletedAt])
  @@map("buildings")
  @@schema("platform_schema")
}

// ==============================================================================
// 6. FLOOR (Physical Level Tier — Terminal Organization Entity)
// ==============================================================================
model Floor {
  id          String    @id
  buildingId  String    @map("building_id")
  code        String
  name        String
  floorNumber Int       @map("floor_number")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  rooms       Room[]

  @@unique([buildingId, code])
  @@unique([buildingId, id], name: "uq_floors_building_id")
  @@index([buildingId])
  @@index([floorNumber])
  @@index([status])
  @@index([deletedAt])
  @@map("floors")
  @@schema("platform_schema")
}

// ==============================================================================
// 7. TRANSACTIONAL OUTBOX (audit_schema.outbox_events)
// ==============================================================================
model OutboxEvent {
  id              String    @id
  specversion     String    @default("1.0")
  type            String
  source          String
  subject         String?
  datacontenttype String    @default("application/json")
  time            DateTime  @default(now())
  data            Json
  tenantId        String?   @map("tenant_id")
  propertyId      String?   @map("property_id")
  correlationId   String?   @map("correlation_id")
  causationId     String?   @map("causation_id")
  published       Boolean   @default(false)
  publishedAt     DateTime? @map("published_at")
  retryCount      Int       @default(0) @map("retry_count")
  lastError       String?   @map("last_error")

  @@index([published, time])
  @@map("outbox_events")
  @@schema("audit_schema")
}

// ==============================================================================
// 8. USER (Unified Identity Core)
// ==============================================================================
model User {
  id                String    @id
  email             String    @unique
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  phone             String?   @map("phone")
  status            String    @default("ACTIVE") @map("status")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  defaultPropertyId String?   @map("default_property_id")
  version           Int       @default(1) @map("version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  defaultProperty   Property?                @relation("UserDefaultProperty", fields: [defaultPropertyId], references: [id], onDelete: SetNull)
  credential        UserCredential?
  passwordHistories PasswordHistory[]
  memberships       OrganizationMembership[]
  roleScopes        UserRoleScope[]
  authSessions      AuthSession[]

  @@index([status])
  @@index([deletedAt])
  @@index([defaultPropertyId])
  @@map("users")
  @@schema("platform_schema")
}

// ==============================================================================
// 9. USER CREDENTIAL (Separate Authentication Secret Persistence)
// ==============================================================================
model UserCredential {
  id                String   @id
  userId            String   @unique @map("user_id")
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  status            String   @default("ACTIVE") @map("status")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
  @@schema("platform_schema")
}

// ==============================================================================
// 10. PASSWORD HISTORY (Previous Credential Hashes for History Validation)
// ==============================================================================
model PasswordHistory {
  id           String   @id
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_histories")
  @@schema("platform_schema")
}

// ==============================================================================
// 11. ORGANIZATION MEMBERSHIP (Multi-Group / Affiliation Modeling)
// ==============================================================================
model OrganizationMembership {
  id           String    @id
  userId       String    @map("user_id")
  hotelGroupId String    @map("hotel_group_id")
  isPrimary    Boolean   @default(false) @map("is_primary")
  status       String    @default("ACTIVE") @map("status")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelGroup HotelGroup @relation(fields: [hotelGroupId], references: [id], onDelete: Restrict)

  @@unique([userId, hotelGroupId])
  @@index([userId])
  @@index([hotelGroupId])
  @@index([status])
  @@index([deletedAt])
  @@map("organization_memberships")
  @@schema("platform_schema")
}

// ==============================================================================
// 12. ROLE (System & Hotel Group Custom Roles)
// ==============================================================================
model Role {
  id           String    @id
  hotelGroupId String?   @map("hotel_group_id")
  code         String    @map("code")
  name         String    @map("name")
  description  String?   @map("description")
  isSystem     Boolean   @default(false) @map("is_system")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  hotelGroup      HotelGroup?      @relation(fields: [hotelGroupId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoleScopes  UserRoleScope[]

  @@index([hotelGroupId])
  @@index([code])
  @@index([isSystem])
  @@index([deletedAt])
  @@map("roles")
  @@schema("platform_schema")
}

// ==============================================================================
// 13. PERMISSION (Normalized Domain Capabilities)
// ==============================================================================
model Permission {
  id          String   @id
  code        String   @unique @map("code")
  name        String   @map("name")
  description String?  @map("description")
  module      String?  @map("module")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
  @@schema("platform_schema")
}

// ==============================================================================
// 14. ROLE PERMISSION (Role-to-Permission Mapping)
// ==============================================================================
model RolePermission {
  id           String   @id
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("platform_schema")
}

// ==============================================================================
// 15. USER ROLE SCOPE (Hierarchically Scoped Role Assignments)
// ==============================================================================
model UserRoleScope {
  id             String   @id
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  scopeType      String   @map("scope_type")
  hotelGroupId   String?  @map("hotel_group_id")
  regionId       String?  @map("region_id")
  countryId      String?  @map("country_id")
  propertyId     String?  @map("property_id")
  departmentCode String?  @map("department_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  hotelGroup HotelGroup? @relation(fields: [hotelGroupId], references: [id], onDelete: Restrict)
  region     Region?     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  country    Country?    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([scopeType])
  @@index([hotelGroupId])
  @@index([regionId])
  @@index([countryId])
  @@index([propertyId])
  @@map("user_role_scopes")
  @@schema("platform_schema")
}

// ==============================================================================
// 16. AUTH SESSION (Server-Side Session & Revocation Metadata)
// ==============================================================================
model AuthSession {
  id               String    @id
  userId           String    @map("user_id")
  sessionToken     String    @unique @map("session_token")
  deviceInfo       String?   @map("device_info")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
  @@schema("platform_schema")
}

// ==============================================================================
// 17. REFRESH TOKEN (Hashed Token Family Rotation Persistence)
// ==============================================================================
model RefreshToken {
  id                String    @id
  sessionId         String    @map("session_id")
  tokenFamily       String    @map("token_family")
  tokenHash         String    @unique @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  session      AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?  @relation("TokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacements RefreshToken[] @relation("TokenReplacement")

  @@index([sessionId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("platform_schema")
}

// ==============================================================================
// 18. SECURITY AUDIT LOG (Append-Only Immutable Ledger)
// ==============================================================================
model SecurityAuditLog {
  id            String   @id
  timestamp     DateTime @default(now()) @map("timestamp")
  actorId       String?  @map("actor_id")
  actorType     String   @default("USER") @map("actor_type")
  action        String   @map("action")
  resourceType  String?  @map("resource_type")
  resourceId    String?  @map("resource_id")
  outcome       String   @map("outcome")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  details       Json?    @map("details")

  @@index([timestamp])
  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@map("security_audit_logs")
  @@schema("audit_schema")
}

// ==============================================================================
// 19. PMS ROOM TYPES (Accommodation Categories)
// ==============================================================================
model RoomType {
  id              String    @id
  propertyId      String    @map("property_id")
  code            String    @db.VarChar(30)
  name            String    @db.VarChar(100)
  description     String?   @db.Text
  roomClass       String    @map("room_class") @db.VarChar(50)
  baseOccupancy   Int       @default(2) @map("base_occupancy")
  maxOccupancy    Int       @default(3) @map("max_occupancy")
  maxAdults       Int       @default(2) @map("max_adults")
  maxChildren     Int       @default(1) @map("max_children")
  bedConfiguration Json     @map("bed_configuration")
  amenities       String[]  @default([])
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  rooms           Room[]
  ratePlans       RatePlanRoomType[]
  dailyInventory  DailyInventory[]
  dailyRates      DailyRate[]
  reservations    Reservation[]

  @@unique([propertyId, code], name: "uq_room_types_property_code")
  @@unique([propertyId, id], name: "uq_room_types_property_id")
  @@index([propertyId, isActive], name: "idx_room_types_property_active")
  @@map("room_types")
  @@schema("pms_schema")
}

// ==============================================================================
// 20. PMS PHYSICAL ROOMS (Architectural Inventory Units)
// ==============================================================================
model Room {
  id              String    @id
  propertyId      String    @map("property_id")
  buildingId      String    @map("building_id")
  floorId         String    @map("floor_id")
  roomTypeId      String    @map("room_type_id")
  roomNumber      String    @map("room_number") @db.VarChar(30)
  name                String?   @db.VarChar(100)
  features            Json?     @map("features")
  housekeepingStatus  String    @default("DIRTY") @map("housekeeping_status") @db.VarChar(20)
  serviceStatus       String    @default("IN_SERVICE") @map("service_status") @db.VarChar(20)
  occupancyStatus     String    @default("VACANT") @map("occupancy_status") @db.VarChar(20)
  version             Int       @default(0)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  building            Building  @relation(fields: [propertyId, buildingId], references: [propertyId, id], onDelete: Restrict)
  floor               Floor     @relation(fields: [buildingId, floorId], references: [buildingId, id], onDelete: Restrict)
  roomType            RoomType  @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)
  maintenanceBlocks   RoomMaintenanceBlock[]
  statusLogs          RoomStatusLog[]

  @@unique([propertyId, id], name: "uq_rooms_property_id")
  @@unique([propertyId, roomNumber], name: "uq_rooms_property_room_number")
  @@index([propertyId, roomTypeId], name: "idx_rooms_property_room_type")
  @@index([propertyId, housekeepingStatus], name: "idx_rooms_property_hk_status")
  @@index([propertyId, serviceStatus], name: "idx_rooms_property_service_status")
  @@index([floorId], name: "idx_rooms_floor")
  @@index([buildingId], name: "idx_rooms_building")
  @@map("rooms")
  @@schema("pms_schema")
}

// ==============================================================================
// 21. PMS RATE PLANS (Commercial Pricing Plans)
// ==============================================================================
model RatePlan {
  id                    String    @id
  propertyId            String    @map("property_id")
  code                  String    @db.VarChar(30)
  name                  String    @db.VarChar(100)
  description           String?   @db.Text
  currency              String    @db.VarChar(3)
  mealPlanCode          String    @default("RO") @map("meal_plan_code") @db.VarChar(20)
  pricingModel          String    @default("PER_ROOM") @map("pricing_model") @db.VarChar(30)
  isClosed              Boolean   @default(false) @map("is_closed")
  isClosedToArrival     Boolean   @default(false) @map("is_closed_to_arrival")
  isClosedToDeparture   Boolean   @default(false) @map("is_closed_to_departure")
  minStayDays           Int       @default(1) @map("min_stay_days")
  maxStayDays           Int?      @map("max_stay_days")
  validFrom             DateTime  @map("valid_from") @db.Date
  validTo               DateTime  @map("valid_to") @db.Date
  cancellationPolicy    Json?     @map("cancellation_policy")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomTypes             RatePlanRoomType[]
  dailyRates            DailyRate[]
  reservations          Reservation[]

  @@unique([propertyId, code], name: "uq_rate_plans_property_code")
  @@unique([propertyId, id], name: "uq_rate_plans_property_id")
  @@index([propertyId, isActive], name: "idx_rate_plans_property_active")
  @@map("rate_plans")
  @@schema("pms_schema")
}

// ==============================================================================
// 22. PMS RATE PLAN ROOM TYPES (Room Type Mapping & Base Rates)
// ==============================================================================
model RatePlanRoomType {
  id              String    @id
  propertyId      String    @map("property_id")
  ratePlanId      String    @map("rate_plan_id")
  roomTypeId      String    @map("room_type_id")
  baseRateAmount  Decimal   @map("base_rate_amount") @db.Decimal(12, 4)
  extraAdultRate  Decimal   @default(0) @map("extra_adult_rate") @db.Decimal(12, 4)
  extraChildRate  Decimal   @default(0) @map("extra_child_rate") @db.Decimal(12, 4)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  ratePlan        RatePlan  @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  roomType        RoomType  @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)

  @@index([ratePlanId, roomTypeId], name: "idx_rate_plan_room_types_plan_room")
  @@index([roomTypeId], name: "idx_rate_plan_room_types_room_type")
  @@map("rate_plan_room_types")
  @@schema("pms_schema")
}

// ==============================================================================
// 23. PMS DAILY RATES (Date-Specific Price & Restriction Overrides)
// ==============================================================================
model DailyRate {
  id                    String    @id
  propertyId            String    @map("property_id")
  ratePlanId            String    @map("rate_plan_id")
  roomTypeId            String    @map("room_type_id")
  businessDate          DateTime  @map("business_date") @db.Date
  baseRateAmount        Decimal   @map("base_rate_amount") @db.Decimal(12, 4)
  extraAdultRate        Decimal?  @map("extra_adult_rate") @db.Decimal(12, 4)
  extraChildRate        Decimal?  @map("extra_child_rate") @db.Decimal(12, 4)
  isClosed              Boolean   @default(false) @map("is_closed")
  isClosedToArrival     Boolean?  @map("is_closed_to_arrival")
  isClosedToDeparture   Boolean?  @map("is_closed_to_departure")
  minStayDays           Int?      @map("min_stay_days")
  maxStayDays           Int?      @map("max_stay_days")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  ratePlan              RatePlan  @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  roomType              RoomType  @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)

  @@unique([ratePlanId, roomTypeId, businessDate], name: "uq_daily_rates_plan_room_date")
  @@index([propertyId, businessDate], name: "idx_daily_rates_property_date")
  @@map("daily_rates")
  @@schema("pms_schema")
}

// ==============================================================================
// 24. PMS DAILY INVENTORY (Operational Capacity Ledger)
// ==============================================================================
model DailyInventory {
  id                    String    @id
  propertyId            String    @map("property_id")
  roomTypeId            String    @map("room_type_id")
  businessDate          DateTime  @map("business_date") @db.Date
  totalRooms            Int       @default(0) @map("total_rooms")
  outOfOrderCount       Int       @default(0) @map("out_of_order_count")
  outOfServiceCount     Int       @default(0) @map("out_of_service_count")
  blockedCount          Int       @default(0) @map("blocked_count")
  bookedCount           Int       @default(0) @map("booked_count")
  overbookingLimit      Int       @default(0) @map("overbooking_limit")
  version               Int       @default(0)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomType              RoomType  @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, roomTypeId, businessDate], name: "uq_daily_inventory_prop_type_date")
  @@index([propertyId, businessDate], name: "idx_daily_inventory_lookup")
  @@map("daily_inventory")
  @@schema("pms_schema")
}

// ==============================================================================
// 25. PMS GUESTS (Operational Property-Local Guest Profiles)
// ==============================================================================
model Guest {
  id                   String        @id
  propertyId           String        @map("property_id")
  firstName            String        @map("first_name") @db.VarChar(50)
  lastName             String        @map("last_name") @db.VarChar(50)
  email                String?       @map("email") @db.VarChar(100)
  phone                String?       @map("phone") @db.VarChar(30)
  identificationType   String?       @map("identification_type") @db.VarChar(30)
  identificationNumber String?       @map("identification_number") @db.VarChar(50)
  crmProfileId         String?       @map("crm_profile_id")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)

  property             Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservations         Reservation[]

  @@unique([propertyId, id], name: "uq_guests_property_id")
  @@index([propertyId, lastName], name: "idx_guests_property_name")
  @@index([propertyId, email], name: "idx_guests_property_email")
  @@index([propertyId, phone], name: "idx_guests_property_phone")
  @@map("guests")
  @@schema("pms_schema")
}

// ==============================================================================
// 26. PMS RESERVATIONS (Central Reservation Aggregate Root)
// ==============================================================================
model Reservation {
  id                 String                 @id
  propertyId         String                 @map("property_id")
  confirmationNumber String                 @map("confirmation_number") @db.VarChar(30)
  idempotencyKey     String?                @map("idempotency_key") @db.VarChar(64)
  status             String                 @default("CONFIRMED") @map("status") @db.VarChar(20)
  guestId            String                 @map("guest_id")
  roomTypeId         String                 @map("room_type_id")
  ratePlanId         String                 @map("rate_plan_id")
  arrivalDate        DateTime               @map("arrival_date") @db.Date
  departureDate      DateTime               @map("departure_date") @db.Date
  adultsCount        Int                    @default(1) @map("adults_count")
  childrenCount      Int                    @default(0) @map("children_count")
  totalAmount        Decimal                @map("total_amount") @db.Decimal(12, 4)
  currency           String                 @map("currency") @db.VarChar(3)
  specialRequests    String?                @map("special_requests") @db.Text
  cancellationReason String?                @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  version            Int                    @default(0)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?              @map("deleted_at") @db.Timestamptz(6)

  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest              Guest                  @relation(fields: [propertyId, guestId], references: [propertyId, id], onDelete: Restrict)
  roomType           RoomType               @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)
  ratePlan           RatePlan               @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  rateNights         ReservationRateNight[]

  @@unique([propertyId, id], name: "uq_reservations_property_id")
  @@unique([propertyId, confirmationNumber], name: "uq_reservations_property_confirmation_number")
  @@unique([propertyId, idempotencyKey], name: "uq_reservations_property_idempotency_key")
  @@index([propertyId, status, arrivalDate], name: "idx_reservations_lookup")
  @@index([propertyId, guestId], name: "idx_reservations_guest")
  @@map("reservations")
  @@schema("pms_schema")
}

// ==============================================================================
// 27. PMS RESERVATION RATE NIGHTS (Immutable Nightly Pricing Snapshot)
// ==============================================================================
model ReservationRateNight {
  id              String      @id
  propertyId      String      @map("property_id")
  reservationId   String      @map("reservation_id")
  businessDate    DateTime    @map("business_date") @db.Date
  baseRateAmount  Decimal     @map("base_rate_amount") @db.Decimal(12, 4)
  extraAdultRate  Decimal     @default(0) @map("extra_adult_rate") @db.Decimal(12, 4)
  extraChildRate  Decimal     @default(0) @map("extra_child_rate") @db.Decimal(12, 4)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 4)
  currency        String      @map("currency") @db.VarChar(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation     Reservation @relation(fields: [propertyId, reservationId], references: [propertyId, id], onDelete: Cascade)

  @@unique([reservationId, businessDate], name: "uq_reservation_rate_nights_res_date")
  @@index([propertyId, businessDate], name: "idx_reservation_rate_nights_lookup")
  @@map("reservation_rate_nights")
  @@schema("pms_schema")
}

// ==============================================================================
// 28. PMS ROOM MAINTENANCE BLOCKS (Authoritative Out-of-Order / Out-of-Service Schedule)
// ==============================================================================
model RoomMaintenanceBlock {
  id                 String    @id
  propertyId         String    @map("property_id")
  roomId             String    @map("room_id")
  type               String    @db.VarChar(20) // OUT_OF_ORDER, OUT_OF_SERVICE
  reason             String    @db.VarChar(255)
  notes              String?   @db.Text
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  status             String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, CANCELLED, COMPLETED
  createdBy          String    @map("created_by")
  cancelledBy        String?   @map("cancelled_by")
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(255)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room               Room      @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, id], name: "uq_room_maintenance_blocks_prop_id")
  @@index([propertyId, roomId, status], name: "idx_room_maintenance_lookup")
  @@index([propertyId, startDate, endDate], name: "idx_room_maintenance_dates")
  @@map("room_maintenance_blocks")
  @@schema("pms_schema")
}

// ==============================================================================
// 29. PMS ROOM STATUS LOGS (Immutable Room Status Audit Ledger)
// ==============================================================================
model RoomStatusLog {
  id                         String    @id
  propertyId                 String    @map("property_id")
  roomId                     String    @map("room_id")
  previousHousekeepingStatus String?   @map("previous_housekeeping_status") @db.VarChar(20)
  newHousekeepingStatus      String?   @map("new_housekeeping_status") @db.VarChar(20)
  previousServiceStatus      String?   @map("previous_service_status") @db.VarChar(20)
  newServiceStatus           String?   @map("new_service_status") @db.VarChar(20)
  reason                     String?   @db.VarChar(255)
  source                     String    @default("MANUAL") @db.VarChar(30)
  changedBy                  String    @map("changed_by")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  property                   Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room                       Room      @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)

  @@index([propertyId, roomId, createdAt], name: "idx_room_status_logs_lookup")
  @@map("room_status_logs")
  @@schema("pms_schema")
}


