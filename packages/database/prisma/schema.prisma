  @@unique([menuItemId, code], name: "uq_fnb_variant_item_code")
  @@index([menuItemId, displayOrder], name: "idx_fnb_variants_item_display")
  @@map("fnb_menu_item_variants")
  @@schema("fnb_schema")
}

// ==============================================================================
