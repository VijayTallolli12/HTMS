  @@unique([propertyId, id], name: "uq_room_maintenance_blocks_prop_id")
  @@index([propertyId, roomId, status], name: "idx_room_maintenance_lookup")
  @@index([propertyId, startDate, endDate], name: "idx_room_maintenance_dates")
  @@map("room_maintenance_blocks")
  @@schema("pms_schema")
