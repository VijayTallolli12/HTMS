  propertyId                 String   @map("property_id")
  roomId                     String   @map("room_id")
  previousHousekeepingStatus String?  @map("previous_housekeeping_status") @db.VarChar(20)
  newHousekeepingStatus      String?  @map("new_housekeeping_status") @db.VarChar(20)
  previousServiceStatus      String?  @map("previous_service_status") @db.VarChar(20)
  newServiceStatus           String?  @map("new_service_status") @db.VarChar(20)
