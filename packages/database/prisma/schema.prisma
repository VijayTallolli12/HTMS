  @@unique([propertyId, roomTypeId, businessDate], name: "uq_daily_inventory_prop_type_date")
  @@index([propertyId, businessDate], name: "idx_daily_inventory_lookup")
  @@map("daily_inventory")
  @@schema("pms_schema")
}

// ==============================================================================
// 25. PMS GUESTS (Operational Property-Local Guest Profiles)
// ==============================================================================
model Guest {
  id                   String    @id
  propertyId           String    @map("property_id")
  firstName            String    @map("first_name") @db.VarChar(50)
  lastName             String    @map("last_name") @db.VarChar(50)
  email                String?   @map("email") @db.VarChar(100)
  phone                String?   @map("phone") @db.VarChar(30)
  identificationType   String?   @map("identification_type") @db.VarChar(30)
  identificationNumber String?   @map("identification_number") @db.VarChar(50)
  crmProfileId         String?   @map("crm_profile_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
