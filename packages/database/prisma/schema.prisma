  changedBy                  String   @map("changed_by")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room     Room     @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)

  @@index([propertyId, roomId, createdAt], name: "idx_room_status_logs_lookup")
  @@map("room_status_logs")
  @@schema("pms_schema")
}

// ==============================================================================
// 30. PMS HOUSEKEEPING TASKS (Operational Workflow Layer — Departure Cleaning Loop)
// ==============================================================================
model HousekeepingTask {
  id                  String    @id
  propertyId          String    @map("property_id")
  roomId              String    @map("room_id")
  reservationId       String?   @map("reservation_id")
  taskType            String    @map("task_type") @db.VarChar(20)
  priority            String    @default("NORMAL") @map("priority") @db.VarChar(10)
  status              String    @default("PENDING") @map("status") @db.VarChar(20)
  assignedAttendantId String?   @map("assigned_attendant_id")
  assignedBy          String?   @map("assigned_by")
  inspectionResult    String?   @map("inspection_result") @db.VarChar(10)
  inspectionNotes     String?   @map("inspection_notes") @db.Text
  rejectionReason     String?   @map("rejection_reason") @db.Text
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  inspectedAt         DateTime? @map("inspected_at") @db.Timestamptz(6)
  inspectedBy         String?   @map("inspected_by")
  version             Int       @default(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([propertyId, reservationId, taskType], name: "uq_hk_task_reservation_type")
  @@index([propertyId, status], name: "idx_hk_task_property_status")
  @@index([propertyId, roomId], name: "idx_hk_task_property_room")
  @@index([propertyId, assignedAttendantId, status], name: "idx_hk_task_attendant_status")
  @@map("housekeeping_tasks")
  @@schema("pms_schema")
}

// ==============================================================================
// 31. PMS RESERVATION ASSIGNMENT LOGS (Immutable Room Assignment Audit Ledger)
// ==============================================================================
model ReservationAssignmentLog {
  id             String   @id
  propertyId     String   @map("property_id")
  reservationId  String   @map("reservation_id")
  previousRoomId String?  @map("previous_room_id")
  newRoomId      String?  @map("new_room_id")
  action         String   @map("action") @db.VarChar(30)
  reason         String?  @db.VarChar(255)
  actorId        String   @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation  Reservation @relation(fields: [propertyId, reservationId], references: [propertyId, id], onDelete: Restrict)
  previousRoom Room?       @relation("AssignmentLogsPrevRoom", fields: [propertyId, previousRoomId], references: [propertyId, id], onDelete: Restrict)
  newRoom      Room?       @relation("AssignmentLogsNewRoom", fields: [propertyId, newRoomId], references: [propertyId, id], onDelete: Restrict)

  @@index([propertyId, reservationId, createdAt], name: "idx_res_assignment_logs_lookup")
  @@index([propertyId, newRoomId, createdAt], name: "idx_room_assignment_logs_lookup")
  @@map("reservation_assignment_logs")
  @@schema("pms_schema")
}

// ==============================================================================
// 31. FINANCE FOLIOS (Guest Billing Ledger Aggregate Root)
// ==============================================================================
model Folio {
  id             String    @id
  tenantId       String    @map("tenant_id")
  propertyId     String    @map("property_id")
  reservationId  String    @map("reservation_id")
  guestId        String    @map("guest_id")
  folioNumber    String    @map("folio_number") @db.VarChar(30)
  status         String    @default("OPEN") @map("status") @db.VarChar(20)
  currency       String    @map("currency") @db.VarChar(3)
  balance        Decimal   @default(0) @map("balance") @db.Decimal(12, 4)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy       String?   @map("closed_by")

  transactions FolioTransaction[]
  payments     Payment[]

  @@unique([propertyId, reservationId, folioNumber], name: "uq_folio_property_res_number")
  @@unique([propertyId, idempotencyKey], name: "uq_folio_property_idempotency")
  @@index([propertyId, reservationId], name: "idx_folio_property_reservation")
  @@index([propertyId, status], name: "idx_folio_property_status")
  @@map("folios")
  @@schema("finance_schema")
}

// ==============================================================================
// 32. FINANCE FOLIO TRANSACTIONS (Immutable Ledger Posting Entries)
// ==============================================================================
model FolioTransaction {
  id              String   @id
  tenantId        String   @map("tenant_id")
  propertyId      String   @map("property_id")
  folioId         String   @map("folio_id")
  transactionCode String   @map("transaction_code") @db.VarChar(50)
  description     String   @db.VarChar(255)
  amount          Decimal  @map("amount") @db.Decimal(12, 4)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 4)
  reasonCode      String?  @map("reason_code") @db.VarChar(50)
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(64)
  payloadHash     String   @map("payload_hash") @db.VarChar(64)
  postedAt        DateTime @map("posted_at") @db.Timestamptz(6)
  postedBy        String   @map("posted_by")

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@unique([propertyId, idempotencyKey], name: "uq_folio_tx_property_idempotency")
  @@index([propertyId, folioId], name: "idx_folio_tx_property_folio")
  @@index([folioId, postedAt], name: "idx_folio_tx_folio_posted")
  @@map("folio_transactions")
  @@schema("finance_schema")
}

// ==============================================================================
// 33. FINANCE PAYMENTS (Immutable Payment Records)
// ==============================================================================
model Payment {
  id              String   @id
  tenantId        String   @map("tenant_id")
  propertyId      String   @map("property_id")
  folioId         String   @map("folio_id")
  amount          Decimal  @map("amount") @db.Decimal(12, 4)
  currency        String   @map("currency") @db.VarChar(3)
  paymentMethod   String   @map("payment_method") @db.VarChar(30)
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  status          String   @default("COMPLETED") @map("status") @db.VarChar(20)
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(64)
  payloadHash     String   @map("payload_hash") @db.VarChar(64)
  processedAt     DateTime @map("processed_at") @db.Timestamptz(6)
  processedBy     String   @map("processed_by")

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@unique([propertyId, idempotencyKey], name: "uq_payment_property_idempotency")
  @@index([propertyId, folioId], name: "idx_payment_property_folio")
  @@map("payments")
  @@schema("finance_schema")
}

// ════════════════════════════════════════════════════════════════════
// ENGINEERING / MAINTENANCE V1 (pms_schema)
// Asset registry, maintenance work orders, preventive schedules.
// Room operational impact continues to be owned by RoomMaintenanceBlock.
// ════════════════════════════════════════════════════════════════════

model Asset {
  id          String    @id
  propertyId  String    @map("property_id")
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(120)
  category    String    @db.VarChar(40) // ELECTRICAL | PLUMBING | HVAC | ...
  status      String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | UNDER_MAINTENANCE | INACTIVE
  description String?   @db.VarChar(500)
  roomId      String?   @map("room_id")
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  property         Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room             Room?                 @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)
  workOrders       WorkOrder[]
  maintenanceSchedules MaintenanceSchedule[]

  @@unique([propertyId, code], name: "uq_assets_property_code")
  @@unique([propertyId, id], name: "uq_assets_property_id")
  @@index([propertyId, status], name: "idx_assets_property_status")
  @@index([propertyId, category], name: "idx_assets_property_category")
  @@map("assets")
  @@schema("pms_schema")
}

model WorkOrder {
  id                   String    @id
  propertyId           String    @map("property_id")
  code                 String    @db.VarChar(30) // Human-readable WO number, unique per property
  title                String    @db.VarChar(150)
  description          String?   @db.VarChar(1000)
  priority             String    @default("MEDIUM") @db.VarChar(10) // LOW | MEDIUM | HIGH | URGENT
  category             String    @db.VarChar(40) // ELECTRICAL | PLUMBING | HVAC | ...
  status               String    @default("OPEN") @db.VarChar(20) // OPEN | ASSIGNED | IN_PROGRESS | COMPLETED | CLOSED
  assetId              String?   @map("asset_id")
  roomId               String?   @map("room_id")
  assignedTechnicianId String?   @map("assigned_technician_id")
  // Logical reference to pms_schema.room_maintenance_blocks (no FK: block
  // lifecycle is owned by the PMS RoomMaintenanceService)
  maintenanceBlockId   String?   @map("maintenance_block_id")
  reportedAt           DateTime  @default(now()) @map("reported_at") @db.Timestamptz(6)
  dueAt                DateTime? @map("due_at") @db.Timestamptz(6)
  assignedAt           DateTime? @map("assigned_at") @db.Timestamptz(6)
  startedAt            DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  completionNotes      String?   @map("completion_notes") @db.VarChar(1000)
  reportedBy           String    @map("reported_by")
  closedBy             String?   @map("closed_by")
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  property  Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  asset     Asset?          @relation(fields: [propertyId, assetId], references: [propertyId, id], onDelete: Restrict)
  room      Room?           @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)
  notes     WorkOrderNote[]

  @@unique([propertyId, code], name: "uq_work_orders_property_code")
  @@unique([propertyId, id], name: "uq_work_orders_property_id")
  @@index([propertyId, status], name: "idx_work_orders_property_status")
  @@index([propertyId, assignedTechnicianId, status], name: "idx_work_orders_property_technician")
  @@index([propertyId, roomId], name: "idx_work_orders_property_room")
  @@map("work_orders")
  @@schema("pms_schema")
}

model WorkOrderNote {
  id          String   @id
  propertyId  String   @map("property_id")
  workOrderId String   @map("work_order_id")
  authorId    String   @map("author_id")
  body        String   @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [propertyId, workOrderId], references: [propertyId, id], onDelete: Cascade)

  @@index([propertyId, workOrderId, createdAt], name: "idx_work_order_notes_lookup")
  @@map("work_order_notes")
  @@schema("pms_schema")
}

model MaintenanceSchedule {
  id              String    @id
  propertyId      String    @map("property_id")
  assetId         String    @map("asset_id")
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(500)
  frequency       String    @db.VarChar(20) // DAILY | WEEKLY | MONTHLY | QUARTERLY | ANNUAL
  nextDueDate     DateTime  @map("next_due_date") @db.Date
  lastCompletedAt DateTime? @map("last_completed_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  asset    Asset    @relation(fields: [propertyId, assetId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, id], name: "uq_maintenance_schedules_property_id")
  @@index([propertyId, isActive, nextDueDate], name: "idx_maintenance_schedules_due_lookup")
  @@map("maintenance_schedules")
  @@schema("pms_schema")
}

// ════════════════════════════════════════════════════════════════════
// NIGHT AUDIT & HOTEL BUSINESS DATE (pms_schema)
// Property-scoped authoritative operational business date, audit runs,
// and step execution tracking.
// ════════════════════════════════════════════════════════════════════

model PropertyBusinessDate {
  propertyId           String    @id @map("property_id")
  currentBusinessDate  DateTime  @map("current_business_date") @db.Date
  previousBusinessDate DateTime? @map("previous_business_date") @db.Date
  isAuditInProgress    Boolean   @default(false) @map("is_audit_in_progress")
  lastAuditRunId       String?   @map("last_audit_run_id")
  lastAuditedAt        DateTime? @map("last_audited_at") @db.Timestamptz(6)
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property             Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  lastAuditRun         NightAuditRun? @relation("LastAuditRun", fields: [lastAuditRunId], references: [id], onDelete: SetNull)

  @@map("property_business_dates")
  @@schema("pms_schema")
}

model NightAuditRun {
  id               String    @id
  propertyId       String    @map("property_id")
  businessDate     DateTime  @map("business_date") @db.Date
  nextBusinessDate DateTime  @map("next_business_date") @db.Date
  status           String    @default("PENDING") @db.VarChar(20) // PENDING | IN_PROGRESS | COMPLETED | FAILED
  executedBy       String    @map("executed_by")
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  failureReason    String?   @map("failure_reason") @db.VarChar(1000)
  metrics          Json?     @map("metrics")
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  steps                 NightAuditStep[]
  propertyBusinessDates PropertyBusinessDate[] @relation("LastAuditRun")

  @@unique([propertyId, businessDate], name: "uq_night_audit_property_date")
  @@index([propertyId, status], name: "idx_night_audit_property_status")
  @@map("night_audit_runs")
  @@schema("pms_schema")
}

model NightAuditStep {
  id             String    @id
  auditRunId     String    @map("audit_run_id")
  stepKey        String    @map("step_key") @db.VarChar(50) // VALIDATION | ROOM_CHARGES | NO_SHOWS | ROLLOVER
  name           String    @db.VarChar(100)
  orderIndex     Int       @map("order_index")
  status         String    @default("PENDING") @db.VarChar(20) // PENDING | RUNNING | COMPLETED | FAILED | SKIPPED
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  itemsProcessed Int       @default(0) @map("items_processed")
  details        Json?     @map("details")
  errorMessage   String?   @map("error_message") @db.VarChar(1000)

  auditRun       NightAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@unique([auditRunId, stepKey], name: "uq_night_audit_steps_run_key")
  @@index([auditRunId, orderIndex], name: "idx_night_audit_steps_order")
  @@map("night_audit_steps")
  @@schema("pms_schema")
}

// ==============================================================================
// 19. F&B OUTLETS (Restaurant / Bar / In-Room Dining / Cafe)
// ==============================================================================
model FnbOutlet {
  id          String    @id
  propertyId  String    @map("property_id")
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  outletType  String    @default("RESTAURANT") @map("outlet_type") @db.VarChar(50) // RESTAURANT | BAR | ROOM_SERVICE | CAFE
  status      String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | INACTIVE
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tables     RestaurantTable[]
  categories FnbMenuCategory[]
  items      FnbMenuItem[]
  orders     FnbOrder[]

  @@unique([propertyId, code], name: "uq_fnb_outlet_property_code")
  @@index([propertyId, status], name: "idx_fnb_outlets_property_status")
  @@map("fnb_outlets")
  @@schema("fnb_schema")
}

// ==============================================================================
// 20. F&B MENU CATEGORIES
// ==============================================================================
model FnbMenuCategory {
  id           String   @id
  propertyId   String   @map("property_id")
  outletId     String   @map("outlet_id")
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet FnbOutlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items  FnbMenuItem[]

  @@unique([outletId, code], name: "uq_fnb_menu_cat_outlet_code")
  @@index([outletId, displayOrder], name: "idx_fnb_menu_cat_display")
  @@map("fnb_menu_categories")
  @@schema("fnb_schema")
}

// ==============================================================================
// 21. F&B MENU ITEMS
// ==============================================================================
model FnbMenuItem {
  id           String   @id
  propertyId   String   @map("property_id")
  outletId     String   @map("outlet_id")
  categoryId   String   @map("category_id")
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("JPY") @db.VarChar(3)
  availability String   @default("AVAILABLE") @db.VarChar(20) // AVAILABLE | UNAVAILABLE
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet         FnbOutlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category       FnbMenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems     FnbOrderItem[]
  variants       FnbMenuItemVariant[]
  modifierGroups FnbModifierGroup[]

  @@unique([outletId, code], name: "uq_fnb_menu_item_outlet_code")
  @@index([categoryId, displayOrder], name: "idx_fnb_menu_items_cat_display")
  @@map("fnb_menu_items")
  @@schema("fnb_schema")
}

// ==============================================================================
// 22. RESTAURANT TABLES
// ==============================================================================
model RestaurantTable {
  id            String   @id
  propertyId    String   @map("property_id")
  outletId      String   @map("outlet_id")
  tableNumber   String   @map("table_number") @db.VarChar(20)
  capacity      Int      @default(4)
  status        String   @default("AVAILABLE") @db.VarChar(20) // AVAILABLE | OCCUPIED | RESERVED | OUT_OF_SERVICE
  activeOrderId String?  @unique @map("active_order_id")
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet      FnbOutlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders      FnbOrder[] @relation("TableOrders")
  activeOrder FnbOrder?  @relation("ActiveTableOrder", fields: [activeOrderId], references: [id], onDelete: SetNull)

  @@unique([outletId, tableNumber], name: "uq_fnb_table_outlet_number")
  @@index([outletId, status], name: "idx_fnb_tables_outlet_status")
  @@map("fnb_tables")
  @@schema("fnb_schema")
}

// ==============================================================================
// 23. F&B ORDERS
// ==============================================================================
model FnbOrder {
  id                 String    @id
  propertyId         String    @map("property_id")
  outletId           String    @map("outlet_id")
  orderNumber        String    @map("order_number") @db.VarChar(50)
  tableId            String?   @map("table_id")
  status             String    @default("OPEN") @db.VarChar(20) // OPEN | ORDERED | PREPARING | READY | SERVED | CLOSED | CANCELLED
  guestCount         Int       @default(1) @map("guest_count")
  serverName         String?   @map("server_name") @db.VarChar(100)
  notes              String?   @db.VarChar(500)
  subtotal           Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency           String    @default("JPY") @db.VarChar(3)
  settlementType     String    @default("ROOM_CHARGE") @map("settlement_type") @db.VarChar(30) // ROOM_CHARGE | DIRECT_PAY
  paymentMethod      String?   @map("payment_method") @db.VarChar(30) // CASH | CREDIT_CARD | ROOM_CHARGE
  reservationId      String?   @map("reservation_id")
  folioId            String?   @map("folio_id")
  folioTransactionId String?   @map("folio_transaction_id")
  roomNumber         String?   @map("room_number") @db.VarChar(20)
  guestName          String?   @map("guest_name") @db.VarChar(150)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy           String?   @map("closed_by")
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet         FnbOutlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table          RestaurantTable? @relation("TableOrders", fields: [tableId], references: [id], onDelete: SetNull)
  activeForTable RestaurantTable? @relation("ActiveTableOrder")
  items          FnbOrderItem[]

  @@unique([propertyId, orderNumber], name: "uq_fnb_order_property_number")
  @@index([propertyId, outletId, status], name: "idx_fnb_orders_prop_outlet_status")
  @@index([tableId], name: "idx_fnb_orders_table")
  @@index([reservationId], name: "idx_fnb_orders_reservation")
  @@map("fnb_orders")
  @@schema("fnb_schema")
}

// ==============================================================================
// 24. F&B ORDER ITEMS
// ==============================================================================
model FnbOrderItem {
  id          String   @id
  orderId     String   @map("order_id")
  menuItemId  String   @map("menu_item_id")
  itemName    String   @map("item_name") @db.VarChar(100)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  notes       String?  @db.VarChar(200)
  status      String   @default("ORDERED") @db.VarChar(20) // ORDERED | PREPARING | READY | SERVED | CANCELLED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    FnbOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem FnbMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId], name: "idx_fnb_order_items_order")
  @@map("fnb_order_items")
  @@schema("fnb_schema")
}

// ==============================================================================
