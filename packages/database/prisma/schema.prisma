  @@schema("pms_schema")
}

// ==============================================================================
// 28. PMS ROOM MAINTENANCE BLOCKS (Authoritative Out-of-Order / Out-of-Service Schedule)
// ==============================================================================
model RoomMaintenanceBlock {
  id                 String    @id
  propertyId         String    @map("property_id")
  roomId             String    @map("room_id")
  type               String    @db.VarChar(20) // OUT_OF_ORDER, OUT_OF_SERVICE
  reason             String    @db.VarChar(255)
  notes              String?   @db.Text
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  status             String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, CANCELLED, COMPLETED
  createdBy          String    @map("created_by")
  cancelledBy        String?   @map("cancelled_by")
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(255)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

