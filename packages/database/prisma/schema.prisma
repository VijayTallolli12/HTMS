// ==============================================================================
// 15. SPA OPERATIONS (spa_schema)
// ==============================================================================

model SpaServiceCategory {
  id           String   @id
  propertyId   String   @map("property_id")
  code         String   @db.VarChar(30)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  services SpaService[]

  @@unique([propertyId, code], name: "uq_spa_service_category_property_code")
  @@index([propertyId, isActive], name: "idx_spa_service_categories_property_active")
  @@map("spa_service_categories")
  @@schema("spa_schema")
}

model SpaService {
  id                 String   @id
  propertyId         String   @map("property_id")
  categoryId         String?  @map("category_id")
  code               String   @db.VarChar(30)
  name               String   @db.VarChar(100)
  description        String?  @db.Text
  durationMinutes    Int      @default(60) @map("duration_minutes")
  price              Decimal  @db.Decimal(12, 2)
  currency           String   @default("JPY") @db.VarChar(3)
  isActive           Boolean  @default(true) @map("is_active")
  availability       String   @default("AVAILABLE") @map("availability") // AVAILABLE | UNAVAILABLE
  eligibleTherapistIds String? @map("eligible_therapist_ids") // JSON array of therapist IDs
  eligibleRoomTypes  String?  @map("eligible_room_types") // JSON array of room types
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  category      SpaServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointments  SpaAppointment[]
  addons        SpaServiceAddon[]

  @@unique([propertyId, code], name: "uq_spa_service_property_code")
  @@unique([propertyId, id], name: "uq_spa_services_property_id")
  @@index([propertyId, isActive], name: "idx_spa_services_property_active")
  @@index([propertyId, categoryId], name: "idx_spa_services_category")
  @@map("spa_services")
  @@schema("spa_schema")
}

model SpaServiceAddon {
  id               String   @id
  propertyId       String   @map("property_id")
  serviceId        String   @map("service_id")
  code             String   @db.VarChar(30)
  name             String   @db.VarChar(100)
  description      String?  @db.Text
  priceAdjustment  Decimal  @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  currency         String   @default("JPY") @db.VarChar(3)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  service  SpaService   @relation(fields: [propertyId, serviceId], references: [propertyId, id], onDelete: Cascade)

  @@unique([serviceId, code], name: "uq_spa_service_addon_service_code")
  @@index([propertyId, serviceId], name: "idx_spa_service_addons_service")
  @@map("spa_service_addons")
  @@schema("spa_schema")
}

model SpaTherapist {
  id         String   @id
  propertyId String   @map("property_id")
  name       String   @db.VarChar(100)
  specialty  String?  @db.VarChar(100)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  appointments SpaAppointment[]

  @@index([propertyId, isActive], name: "idx_spa_therapists_property_active")
  @@map("spa_therapists")
  @@schema("spa_schema")
}

model SpaRoom {
  id         String   @id
  propertyId String   @map("property_id")
  name       String   @db.VarChar(50) // e.g. "Lotus Suite", "Zen Room 1"
  roomType   String   @default("SINGLE") @map("room_type") @db.VarChar(30) // SINGLE | COUPLES | HYDROTHERAPY | FACIAL
  status     String   @default("AVAILABLE") @db.VarChar(20) // AVAILABLE | OUT_OF_SERVICE
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  appointments SpaAppointment[]

  @@unique([propertyId, name], name: "uq_spa_room_property_name")
  @@index([propertyId, status], name: "idx_spa_rooms_property_status")
  @@map("spa_rooms")
  @@schema("spa_schema")
}

model SpaAppointment {
  id                 String    @id
  propertyId         String    @map("property_id")
  appointmentNumber  String    @map("appointment_number") @db.VarChar(30)
  serviceId          String    @map("service_id")
  therapistId        String    @map("therapist_id")
  roomId             String    @map("room_id")
  startTime          DateTime  @map("start_time") @db.Timestamptz(6)
  endTime            DateTime  @map("end_time") @db.Timestamptz(6)
  durationMinutes    Int       @map("duration_minutes")
  price              Decimal   @db.Decimal(12, 2)
  currency           String    @default("JPY") @db.VarChar(3)
  status             String    @default("SCHEDULED") @db.VarChar(20) // SCHEDULED | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  guestName          String?   @map("guest_name") @db.VarChar(100)
  guestPhone         String?   @map("guest_phone") @db.VarChar(30)
  roomNumber         String?   @map("room_number") @db.VarChar(20)
  reservationId      String?   @map("reservation_id")
  folioId            String?   @map("folio_id")
  folioTransactionId String?   @map("folio_transaction_id")
  settlementType     String?   @map("settlement_type") @db.VarChar(20) // ROOM_CHARGE | DIRECT_PAY
  paymentMethod      String?   @map("payment_method") @db.VarChar(20) // ROOM_CHARGE | CASH | CREDIT_CARD
  notes              String?   @db.Text
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy        String?   @map("completed_by")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property  Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  service   SpaService   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  therapist SpaTherapist @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  room      SpaRoom      @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([propertyId, appointmentNumber], name: "uq_spa_appointment_number")
  @@index([propertyId, startTime], name: "idx_spa_appointments_property_time")
  @@index([propertyId, therapistId, startTime, endTime], name: "idx_spa_therapist_schedule")
  @@index([propertyId, roomId, startTime, endTime], name: "idx_spa_room_schedule")
  @@index([propertyId, status], name: "idx_spa_appointments_status")
  @@map("spa_appointments")
  @@schema("spa_schema")
}

// ==============================================================================
// 34. EVENT VENUE (Banquet Halls, Ballrooms, Meeting Rooms)
// ==============================================================================
model EventVenue {
  id         String   @id
  propertyId String   @map("property_id")
  code       String
  name       String
  venueType  String   @default("BALLROOM") @map("venue_type")
  capacity   Int
  location   String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  bookings EventBooking[]

  @@unique([propertyId, code], name: "uq_event_venue_property_code")
  @@index([propertyId], name: "idx_event_venues_property")
  @@map("event_venues")
  @@schema("events_schema")
}

// ==============================================================================
// 35. EVENT PACKAGE (Catering & Banquet Packages)
// ==============================================================================
model EventPackage {
  id            String   @id
  propertyId    String   @map("property_id")
  code          String
  name          String
  description   String?
  pricePerGuest Decimal  @map("price_per_guest") @db.Decimal(12, 2)
  currency      String   @default("JPY")
  minGuests     Int      @default(1) @map("min_guests")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  bookings EventBooking[]

  @@unique([propertyId, code], name: "uq_event_package_property_code")
  @@index([propertyId], name: "idx_event_packages_property")
  @@map("event_packages")
  @@schema("events_schema")
}

// ==============================================================================
// 36. EVENT RESOURCE (Equipment, AV, Furniture, Audio/Sound)
// ==============================================================================
model EventResource {
  id            String   @id
  propertyId    String   @map("property_id")
  name          String
  resourceType  String   @default("EQUIPMENT") @map("resource_type")
  totalQuantity Int      @map("total_quantity")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property    Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  allocations EventBookingResource[]

  @@unique([propertyId, name], name: "uq_event_resource_property_name")
  @@index([propertyId], name: "idx_event_resources_property")
  @@map("event_resources")
  @@schema("events_schema")
}

// ==============================================================================
// 37. EVENT BOOKING (Event Reservation & Banquet Folio Billing)
// ==============================================================================
model EventBooking {
  id                 String    @id
  propertyId         String    @map("property_id")
  bookingNumber      String    @map("booking_number")
  venueId            String    @map("venue_id")
  packageId          String?   @map("package_id")
  hostName           String    @map("host_name")
  hostEmail          String?   @map("host_email")
  hostPhone          String?   @map("host_phone")
  eventName          String    @map("event_name")
  eventType          String    @default("CONFERENCE") @map("event_type")
  startTime          DateTime  @map("start_time") @db.Timestamptz(6)
  endTime            DateTime  @map("end_time") @db.Timestamptz(6)
  expectedGuests     Int       @map("expected_guests")
  estimatedAmount    Decimal   @map("estimated_amount") @db.Decimal(12, 2)
  currency           String    @default("JPY")
  status             String    @default("DRAFT")
  notes              String?
  roomNumber         String?   @map("room_number")
  reservationId      String?   @map("reservation_id")
  folioId            String?   @map("folio_id")
  folioTransactionId String?   @map("folio_transaction_id")
  settlementType     String?   @map("settlement_type")
  paymentMethod      String?   @map("payment_method")
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy        String?   @map("completed_by")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property            Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  venue               EventVenue             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  package             EventPackage?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  resourceAllocations EventBookingResource[]

  @@unique([propertyId, bookingNumber], name: "uq_event_booking_number")
  @@index([propertyId, startTime], name: "idx_event_bookings_property_time")
  @@index([propertyId, venueId, startTime, endTime], name: "idx_event_venue_schedule")
  @@index([propertyId, status], name: "idx_event_bookings_status")
  @@map("event_bookings")
  @@schema("events_schema")
}

// ==============================================================================
// 38. EVENT BOOKING RESOURCE ALLOCATION
// ==============================================================================
model EventBookingResource {
  id         String   @id
  bookingId  String   @map("booking_id")
  resourceId String   @map("resource_id")
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking  EventBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource EventResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, resourceId], name: "uq_booking_resource")
  @@index([bookingId], name: "idx_booking_resources_booking")
  @@index([resourceId], name: "idx_booking_resources_resource")
  @@map("event_booking_resources")
  @@schema("events_schema")
}

// ===============================================================================
// 34. PROCUREMENT & INVENTORY MODELS (New Slice)
// ===============================================================================

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@schema("pms_schema")
}

model Supplier {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  name       String   @db.VarChar(120)
  code       String   @db.VarChar(30)
  contact    String?  @db.VarChar(100)
  email      String?  @db.VarChar(100)
  phone      String?  @db.VarChar(30)
  active     Boolean  @default(true) @map("active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([propertyId, code], name: "uq_supplier_property_code")
  @@unique([propertyId, id], name: "uq_supplier_property_id")
  @@index([propertyId, active], name: "idx_supplier_property_active")
  @@map("suppliers")
  @@schema("pms_schema")
}

model InventoryItem {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  name          String   @db.VarChar(120)
  sku           String   @db.VarChar(30)
  category      String   @db.VarChar(60)
  unit          String   @db.VarChar(20)
  reorderLevel  Int      @default(0) @map("reorder_level")
  active        Boolean  @default(true) @map("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockBalances      StockBalance[]

  @@unique([propertyId, sku], name: "uq_inventory_item_property_sku")
  @@unique([propertyId, id], name: "uq_inventory_item_property_id")
  @@index([propertyId, category], name: "idx_inventory_item_property_category")
  @@map("inventory_items")
  @@schema("pms_schema")
}

model PurchaseOrder {
  id             String             @id @default(uuid())
  propertyId     String             @map("property_id")
  supplierId     String             @map("supplier_id")
  poNumber       String             @db.VarChar(30)
  status         PurchaseOrderStatus @default(DRAFT) @map("status")
  orderDate      DateTime           @map("order_date") @db.Date
  expectedDate   DateTime?          @map("expected_date") @db.Date
  totalAmount    Decimal            @default(0) @map("total_amount") @db.Decimal(12,4)
  notes          String?            @db.Text
  version        Int                @default(0)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([propertyId, poNumber], name: "uq_purchase_order_property_number")
  @@unique([propertyId, id], name: "uq_purchase_order_property_id")
  @@index([propertyId, status], name: "idx_purchase_order_property_status")
  @@map("purchase_orders")
  @@schema("pms_schema")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  inventoryItemId  String   @map("inventory_item_id")
  quantity         Int      @map("quantity")
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12,4)
  totalCost        Decimal  @map("total_cost") @db.Decimal(12,4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, inventoryItemId], name: "uq_po_item_po_item")
  @@map("purchase_order_items")
  @@schema("pms_schema")
}

model GoodsReceipt {
  id               String   @id @default(uuid())
  propertyId       String   @map("property_id")
  purchaseOrderId  String   @map("purchase_order_id")
  receiptNumber    String   @db.VarChar(30)
  receivedDate     DateTime @map("received_date") @db.Date
  status           String   @default("POSTED") @map("status") @db.VarChar(20)
  notes            String?  @db.Text
  idempotencyKey   String   @unique @map("idempotency_key") @db.VarChar(64)
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items GoodsReceiptItem[]

  @@unique([propertyId, receiptNumber], name: "uq_goods_receipt_property_number")
  @@unique([propertyId, id], name: "uq_goods_receipt_property_id")
  @@map("goods_receipts")
  @@schema("pms_schema")
}

model GoodsReceiptItem {
  id                String   @id @default(uuid())
  receiptId         String   @map("receipt_id")
  inventoryItemId   String   @map("inventory_item_id")
  orderedQuantity   Int      @map("ordered_quantity")
  receivedQuantity  Int      @map("received_quantity")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([receiptId, inventoryItemId], name: "uq_goods_receipt_item_receipt_item")
  @@map("goods_receipt_items")
  @@schema("pms_schema")
}

model StockBalance {
  id               String   @id @default(uuid())
  propertyId       String   @map("property_id")
  inventoryItemId  String   @map("inventory_item_id")
  onHand           Int      @default(0) @map("on_hand")
  reserved         Int      @default(0) @map("reserved")
  available        Int      @default(0) @map("available")
  reorderLevel     Int      @default(0) @map("reorder_level")
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([propertyId, inventoryItemId], name: "uq_stock_balance_property_item")
  @@index([propertyId, inventoryItemId], name: "idx_stock_balance_property_item")
  @@map("stock_balances")
  @@schema("pms_schema")
}

// End of Procurement & Inventory models

// ===============================================================================
// 35. HR & PAYROLL MODELS (New Slice)
// ===============================================================================

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE

  @@schema("pms_schema")
}

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  PROCESSED
  CLOSED

  @@schema("pms_schema")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATING
  CALCULATED
  FINALIZED

  @@schema("pms_schema")
}

model Employee {
  id                String    @id @default(uuid())
  propertyId        String    @map("property_id")
  employeeCode      String    @map("employee_code") @db.VarChar(30)
  firstName         String    @map("first_name") @db.VarChar(50)
  lastName          String    @map("last_name") @db.VarChar(50)
  email             String?   @db.VarChar(100)
  phone             String?   @db.VarChar(30)
  hireDate          DateTime  @map("hire_date") @db.Date
  terminationDate   DateTime? @map("termination_date") @db.Date
  status            EmploymentStatus @default(ACTIVE) @map("status")
  department        String?   @db.VarChar(50)
  position          String?   @db.VarChar(50)
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  property          Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  compensations     EmployeeCompensation[]
  payrollLines      PayrollLine[]

  @@unique([propertyId, employeeCode], name: "uq_employee_property_code")
  @@unique([propertyId, id], name: "uq_employee_property_id")
  @@index([propertyId, status], name: "idx_employee_property_status")
  @@map("employees")
  @@schema("pms_schema")
}

model EmployeeCompensation {
  id                String   @id @default(uuid())
  propertyId        String   @map("property_id")
  employeeId        String   @map("employee_id")
  effectiveDate     DateTime @map("effective_date") @db.Date
  basicSalary       Decimal  @map("basic_salary") @db.Decimal(12, 4)
  housingAllowance  Decimal  @default(0) @map("housing_allowance") @db.Decimal(12, 4)
  transportAllowance Decimal @default(0) @map("transport_allowance") @db.Decimal(12, 4)
  otherAllowance    Decimal  @default(0) @map("other_allowance") @db.Decimal(12, 4)
  currency          String   @default("JPY") @db.VarChar(3)
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [propertyId, employeeId], references: [propertyId, id], onDelete: Cascade)

  @@unique([propertyId, id], name: "uq_compensation_property_id")
  @@unique([propertyId, employeeId, effectiveDate], name: "uq_compensation_employee_effective")
  @@index([propertyId, employeeId], name: "idx_compensation_employee")
  @@map("employee_compensations")
  @@schema("pms_schema")
}

model PayrollPeriod {
  id           String             @id @default(uuid())
  propertyId   String             @map("property_id")
  periodStart  DateTime           @map("period_start") @db.Date
  periodEnd    DateTime           @map("period_end") @db.Date
  status       PayrollPeriodStatus @default(OPEN) @map("status")
  processedAt  DateTime?          @map("processed_at") @db.Timestamptz(6)
  processedBy  String?            @map("processed_by")
  version      Int                @default(0)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  runs     PayrollRun[]

  @@unique([propertyId, id], name: "uq_payroll_period_property_id")
  @@unique([propertyId, periodStart, periodEnd], name: "uq_payroll_period_dates")
  @@index([propertyId, status], name: "idx_payroll_period_status")
  @@map("payroll_periods")
  @@schema("pms_schema")
}

model PayrollRun {
  id                 String           @id @default(uuid())
  propertyId         String           @map("property_id")
  payrollPeriodId    String           @map("payroll_period_id")
  status             PayrollRunStatus @default(DRAFT) @map("status")
  totalGross         Decimal          @default(0) @map("total_gross") @db.Decimal(12, 4)
  totalDeductions    Decimal          @default(0) @map("total_deductions") @db.Decimal(12, 4)
  totalNet           Decimal          @default(0) @map("total_net") @db.Decimal(12, 4)
  calculatedAt       DateTime?        @map("calculated_at") @db.Timestamptz(6)
  calculatedBy       String?          @map("calculated_by")
  finalizedAt        DateTime?        @map("finalized_at") @db.Timestamptz(6)
  finalizedBy        String?          @map("finalized_by")
  idempotencyKey     String?          @unique @map("idempotency_key") @db.VarChar(64)
  version            Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(6)

  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  payrollPeriod PayrollPeriod @relation(fields: [propertyId, payrollPeriodId], references: [propertyId, id], onDelete: Restrict)
  lines         PayrollLine[]

  @@unique([propertyId, id], name: "uq_payroll_run_property_id")
  @@index([propertyId, payrollPeriodId], name: "idx_payroll_run_period")
  @@index([propertyId, status], name: "idx_payroll_run_status")
  @@map("payroll_runs")
  @@schema("pms_schema")
}

model PayrollLine {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  payrollRunId    String   @map("payroll_run_id")
  employeeId      String   @map("employee_id")
  basic           Decimal  @db.Decimal(12, 4)
  housingAllowance Decimal @default(0) @map("housing_allowance") @db.Decimal(12, 4)
  transportAllowance Decimal @default(0) @map("transport_allowance") @db.Decimal(12, 4)
  otherAllowance  Decimal  @default(0) @map("other_allowance") @db.Decimal(12, 4)
  overtime        Decimal  @default(0) @db.Decimal(12, 4)
  gross           Decimal  @db.Decimal(12, 4)
  deductions      Decimal  @default(0) @db.Decimal(12, 4)
  net             Decimal  @db.Decimal(12, 4)
  currency        String   @default("JPY") @db.VarChar(3)
  version         Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun @relation(fields: [propertyId, payrollRunId], references: [propertyId, id], onDelete: Cascade)
  employee   Employee   @relation(fields: [propertyId, employeeId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, id], name: "uq_payroll_line_property_id")
  @@unique([payrollRunId, employeeId], name: "uq_payroll_line_run_employee")
  @@index([propertyId, payrollRunId], name: "idx_payroll_line_run")
  @@index([propertyId, employeeId], name: "idx_payroll_line_employee")
  @@map("payroll_lines")
  @@schema("pms_schema")
}

// End of HR & Payroll models
// 36. REVENUE MANAGEMENT MODELS (New Slice)
// ==============================================================================

model MarketRateProvider {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  providerName    String   @map("provider_name") @db.VarChar(100)
  providerType    String   @map("provider_type") @db.VarChar(30) // DEMO_COMPSET | DEMO_OTA | CUSTOM
  configuration   Json     @default("{}") @map("configuration")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastError       String?  @map("last_error")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, id], name: "uq_market_rate_provider_property_id")
  @@index([propertyId, isEnabled], name: "idx_market_rate_provider_enabled")
  @@map("market_rate_providers")
  @@schema("pms_schema")
}

model CompetitorSet {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  competitorCode  String   @map("competitor_code") @db.VarChar(30)
  competitorName  String   @map("competitor_name") @db.VarChar(100)
  segment         String   @default("UPSCALE") @db.VarChar(20) // LUXURY | UPSCALE | MIDSCALE | ECONOMY
  distanceKm      Decimal? @map("distance_km") @db.Decimal(6, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, competitorCode], name: "uq_competitor_set_property_code")
  @@unique([propertyId, id], name: "uq_competitor_set_property_id")
  @@index([propertyId, isActive], name: "idx_competitor_set_active")
  @@map("competitor_set")
  @@schema("pms_schema")
}

// End of Revenue Management models
