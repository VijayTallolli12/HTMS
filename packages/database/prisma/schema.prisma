  communicationPreferences Json?    @map("communication_preferences")
  marketingConsent        Boolean   @default(false) @map("marketing_consent")
  tags                    String[]  @default([])
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  guest     Guest   @relation(fields: [propertyId, guestId], references: [propertyId, id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, id], name: "uq_crm_profile_property_id")
  @@unique([propertyId, guestId], name: "uq_crm_profile_guest")
  @@index([propertyId, vipFlag], name: "idx_crm_profile_vip")
  @@map("guest_crm_profiles")
  @@schema("pms_schema")
}

// ==============================================================================
// 27. CRM GUEST PREFERENCES
// ==============================================================================
model GuestPreference {
  id          String    @id
  propertyId  String    @map("property_id")
  guestId     String    @map("guest_id")
  category    String    @db.VarChar(50) // ROOM, DINING, SERVICE, AMENITY, COMMUNICATION, OTHER
  preference  String    @db.VarChar(100)
  value       String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  guest   Guest   @relation(fields: [propertyId, guestId], references: [propertyId, id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, guestId, category, preference], name: "uq_guest_preference_unique")
  @@index([propertyId, guestId], name: "idx_guest_preferences_guest")
  @@map("guest_preferences")
  @@schema("pms_schema")
}

// ==============================================================================
// 28. LOYALTY MEMBERSHIP
// ==============================================================================
model LoyaltyMembership {
  id               String    @id
  propertyId       String    @map("property_id")
  guestId          String    @unique @map("guest_id")
  membershipNumber String    @unique @map("membership_number") @db.VarChar(30)
  tier             String    @default("STANDARD") // STANDARD, SILVER, GOLD, PLATINUM
  pointsBalance    Int       @default(0) @map("points_balance")
  lifetimePoints   Int       @default(0) @map("lifetime_points")
  joinedDate       DateTime  @map("joined_date") @db.Date
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  guest       Guest                @relation(fields: [propertyId, guestId], references: [propertyId, id], onDelete: Cascade)
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  transactions LoyaltyTransaction[]

  @@unique([propertyId, id], name: "uq_loyalty_membership_property_id")
  @@unique([propertyId, guestId], name: "uq_loyalty_membership_guest")
  @@index([propertyId, tier], name: "idx_loyalty_membership_tier")
  @@index([propertyId, active], name: "idx_loyalty_membership_active")
  @@map("loyalty_memberships")
  @@schema("pms_schema")
}

// ==============================================================================
// 29. LOYALTY TRANSACTION
// ==============================================================================
model LoyaltyTransaction {
  id                String    @id
  propertyId        String    @map("property_id")
  membershipId      String    @map("membership_id")
  type              String    // EARN, REDEEM, ADJUST, EXPIRE
  points            Int
  reference         String?   @db.VarChar(64) // reservationId, folioId, or manual reference
  referenceType     String?   @map("reference_type") @db.VarChar(30) // RESERVATION, FOLIO, MANUAL, NIGHT_AUDIT
  description       String?   @db.VarChar(500)
  idempotencyKey    String?   @unique @map("idempotency_key") @db.VarChar(64)
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  membership LoyaltyMembership @relation(fields: [propertyId, membershipId], references: [propertyId, id], onDelete: Cascade)
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, id], name: "uq_loyalty_tx_property_id")
  @@index([propertyId, membershipId, createdAt(sort: Desc)], name: "idx_loyalty_tx_membership_date")
  @@index([propertyId, idempotencyKey], name: "idx_loyalty_tx_idempotency")
  @@map("loyalty_transactions")
  @@schema("pms_schema")
}

// ==============================================================================
// 26. PMS RESERVATIONS (Central Reservation Aggregate Root)
// ==============================================================================
model Reservation {
  id                     String    @id
  propertyId             String    @map("property_id")
  confirmationNumber     String    @map("confirmation_number") @db.VarChar(30)
  idempotencyKey         String?   @map("idempotency_key") @db.VarChar(64)
  status                 String    @default("CONFIRMED") @map("status") @db.VarChar(20)
  guestId                String    @map("guest_id")
  roomTypeId             String    @map("room_type_id")
  ratePlanId             String    @map("rate_plan_id")
  arrivalDate            DateTime  @map("arrival_date") @db.Date
  departureDate          DateTime  @map("departure_date") @db.Date
  adultsCount            Int       @default(1) @map("adults_count")
  childrenCount          Int       @default(0) @map("children_count")
  totalAmount            Decimal   @map("total_amount") @db.Decimal(12, 4)
  currency               String    @map("currency") @db.VarChar(3)
  specialRequests        String?   @map("special_requests") @db.Text
  cancellationReason     String?   @map("cancellation_reason") @db.Text
  cancelledAt            DateTime? @map("cancelled_at") @db.Timestamptz(6)
  assignedRoomId         String?   @map("assigned_room_id")
  assignedAt             DateTime? @map("assigned_at") @db.Timestamptz(6)
  assignedBy             String?   @map("assigned_by")
  checkInAt              DateTime? @map("check_in_at") @db.Timestamptz(6)
  checkedInBy            String?   @map("checked_in_by")
  checkInIdempotencyKey  String?   @map("check_in_idempotency_key") @db.VarChar(64)
  checkInPayloadHash     String?   @map("check_in_payload_hash") @db.VarChar(64)
  checkOutAt             DateTime? @map("check_out_at") @db.Timestamptz(6)
  checkedOutBy           String?   @map("checked_out_by")
  checkOutIdempotencyKey String?   @map("check_out_idempotency_key") @db.VarChar(64)
  checkOutPayloadHash    String?   @map("check_out_payload_hash") @db.VarChar(64)
  version                Int       @default(0)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  property       Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest          Guest                      @relation(fields: [propertyId, guestId], references: [propertyId, id], onDelete: Restrict)
  roomType       RoomType                   @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)
  ratePlan       RatePlan                   @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  rateNights     ReservationRateNight[]
  assignedRoom   Room?                      @relation("RoomAssignedReservations", fields: [propertyId, assignedRoomId], references: [propertyId, id], onDelete: Restrict)
  assignmentLogs ReservationAssignmentLog[]
  housekeepingTasks HousekeepingTask[]

  @@unique([propertyId, id], name: "uq_reservations_property_id")
  @@unique([propertyId, confirmationNumber], name: "uq_reservations_property_confirmation_number")
  @@unique([propertyId, idempotencyKey], name: "uq_reservations_property_idempotency_key")
  @@unique([propertyId, checkInIdempotencyKey], name: "uq_reservations_checkin_idempotency")
  @@unique([propertyId, checkOutIdempotencyKey], name: "uq_reservations_checkout_idempotency")
  @@index([propertyId, assignedRoomId], name: "idx_reservations_property_assigned_room")
  @@index([propertyId, status, arrivalDate], name: "idx_reservations_lookup")
  @@index([propertyId, guestId], name: "idx_reservations_guest")
  @@map("reservations")
  @@schema("pms_schema")
}

// ==============================================================================
// 27. PMS RESERVATION RATE NIGHTS (Immutable Nightly Pricing Snapshot)
