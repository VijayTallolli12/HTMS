  @@unique([propertyId, id], name: "uq_guests_property_id")
  @@index([propertyId, lastName], name: "idx_guests_property_name")
  @@index([propertyId, email], name: "idx_guests_property_email")
  @@index([propertyId, phone], name: "idx_guests_property_phone")
  @@map("guests")
  @@schema("pms_schema")
}

// ==============================================================================
// 26. CRM GUEST PROFILE (CRM Extension)
// ==============================================================================
model GuestCrmProfile {
  id                      String    @id
  propertyId              String    @map("property_id")
  guestId                 String    @unique @map("guest_id")
  vipFlag                 Boolean   @default(false) @map("vip_flag")
