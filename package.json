{
  "name": "enterprise-hms",
  "version": "1.0.0",
  "description": "Enterprise Hospitality Operating Platform — Monorepo Foundation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@hms/api-core",
    "dev:web": "npm run dev --workspace=@hms/web-shell",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspace=@hms/api-contracts --workspace=@hms/shared --workspace=@hms/config --workspace=@hms/database --workspace=@hms/ui",
    "build:apps": "npm run build --workspace=@hms/api-core && npm run build --workspace=@hms/web-shell",
    "build:api": "npm run build --workspace=@hms/api-core",
    "build:web": "npm run build --workspace=@hms/web-shell",
    "vercel:prepare": "node scripts/prepare-vercel.js",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "test:e2e": "playwright test --config=tests/e2e-playwright/playwright.config.ts",
    "test:all": "jest --config jest.config.js --runInBand",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --check \"{apps,packages,tests,infra}/**/*.{ts,js,json,md,html,scss,css}\"",
    "format:fix": "prettier --write \"{apps,packages,tests,infra}/**/*.{ts,js,json,md,html,scss,css}\"",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@playwright/test": "1.44.0",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.11",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "concurrently": "8.2.2",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "rimraf": "5.0.7",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "typescript": "5.4.5"
  }
}
