# ==============================================================================
# Enterprise HMS — Environment Configuration
# Architecture Baseline: W1-T01
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit real passwords, secrets, or API keys to version control.
# In production, inject these secrets via KMS/Secrets Manager or CI/CD pipelines.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Target environment: development | test | staging | production
NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# POSTGRESQL PERSISTENCE
# ------------------------------------------------------------------------------
# Note: Host port is mapped to 5433 by default to avoid conflict if a local
# PostgreSQL service is running on host port 5432.
# Set to 5432 if your host port 5432 is free.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_hms_db
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=change_this_in_production_hms_pass_2026
POSTGRES_SSL=false
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=platform_schema

# ------------------------------------------------------------------------------
# RABBITMQ MESSAGE BROKER (AMQP 0-9-1)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=hms_rabbit
RABBITMQ_PASSWORD=change_this_in_production_rabbit_pass_2026
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ------------------------------------------------------------------------------
# REDIS DISTRIBUTED CACHE & LOCKS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# In docker-compose, this password is required. Supply a strong password here:
REDIS_PASSWORD=change_this_in_production_redis_pass_2026

# ------------------------------------------------------------------------------
# MAILPIT LOCAL SMTP & WEB UI
# ------------------------------------------------------------------------------
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# ------------------------------------------------------------------------------
# API SECURITY & CORRELATION
# ------------------------------------------------------------------------------
# Correlation ID header: X-Correlation-ID
# Property ID header: X-Property-ID
# Tenant ID header: X-Tenant-ID
CORS_ORIGIN=http://localhost:4200
API_PREFIX=/api/v1
