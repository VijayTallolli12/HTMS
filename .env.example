# ==============================================================================
# Enterprise HMS — Environment Configuration
# Architecture Baseline: W1-T01
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit real passwords, secrets, or API keys to version control.
# In production, inject these secrets via KMS/Secrets Manager or CI/CD pipelines.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Target environment: development | test | staging | production
NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# POSTGRESQL PERSISTENCE
# ------------------------------------------------------------------------------
# Note: Host port is mapped to 5433 by default to avoid conflict if a local
# PostgreSQL service is running on host port 5432.
# Set to 5432 if your host port 5432 is free.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_hms_db
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=change_this_in_production_hms_pass_2026
POSTGRES_SSL=false
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=platform_schema

# ------------------------------------------------------------------------------
# RABBITMQ MESSAGE BROKER (AMQP 0-9-1)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=hms_rabbit
RABBITMQ_PASSWORD=change_this_in_production_rabbit_pass_2026
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ------------------------------------------------------------------------------
# REDIS DISTRIBUTED CACHE & LOCKS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# In docker-compose, this password is required. Supply a strong password here:
REDIS_PASSWORD=change_this_in_production_redis_pass_2026

# ------------------------------------------------------------------------------
# MAILPIT LOCAL SMTP & WEB UI
# ------------------------------------------------------------------------------
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# ------------------------------------------------------------------------------
# API SECURITY & CORRELATION
# ------------------------------------------------------------------------------
# Correlation ID header: X-Correlation-ID
# Property ID header: X-Property-ID
# Tenant ID header: X-Tenant-ID
CORS_ORIGIN=http://localhost:4200
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# W1-T03: IDENTITY & AUTHENTICATION (RS256 JWT, ARGON2ID, THROTTLING)
# ------------------------------------------------------------------------------
# JWT Signing Algorithm (RS256 required by frozen architecture)
JWT_ALGORITHM=RS256

# JWT Key ID for rotation and JWKS publishing
JWT_KEY_ID=hms-auth-key-v1

# JWT Issuer and Audience claims
JWT_ISSUER=urn:hms:api
JWT_AUDIENCE=urn:hms:client

# Access Token TTL in seconds (Default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900

# Refresh Token TTL in seconds
# Staff: 28800 = 8 hours; Guest: 2592000 = 30 days
REFRESH_TOKEN_STAFF_EXPIRES_IN_SECONDS=28800
REFRESH_TOKEN_GUEST_EXPIRES_IN_SECONDS=2592000

# RSA 2048-bit Key Pair (PEM formatted).
# REQUIRED in production and staging environments.
# In development/test environments, if omitted or empty, an ephemeral RSA 2048
# keypair is generated in memory at startup for safe local development.
# IMPORTANT: NEVER commit private key material to source control!
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Password Policy (Argon2id target parameters: m=65536, t=3, p=4)
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST_ITERATIONS=3
ARGON2_PARALLELISM_THREADS=4
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_BREACHED_CHECK_ENABLED=true

# Authentication Throttling & Progressive Delay (Redis dual-axis)
THROTTLING_IP_WINDOW_SECONDS=900
THROTTLING_IP_MAX_ATTEMPTS=20
THROTTLING_ACCOUNT_WINDOW_SECONDS=900
THROTTLING_ACCOUNT_MAX_ATTEMPTS=5
