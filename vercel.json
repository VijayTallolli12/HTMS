{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web-shell/dist/web-shell/browser",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|\\.well-known).*)",
      "destination": "/index.html"
    }
  ]
}
